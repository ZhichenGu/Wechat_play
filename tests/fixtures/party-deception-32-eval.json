    {"id":"holdout-identity","text":"别用语气糊弄我，你真是这个账号本人吗？","strategy":"evade_contradiction"}
  ],
  "finalTurns": [
    {"id":"final-identity-direct","text":"你今天说话怎么这么不像你？别只说语气没变。","strategy":"evade_contradiction"},
