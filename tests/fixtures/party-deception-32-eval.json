  "turns": [
    {"id":"concern","text":"我现在心跳有点快，脑子也乱，你先让我说两句。","strategy":"feigned_concern"},
    {"id":"false-location","text":"我好像在 B03 附近，但也可能记错了。","strategy":"ambiguous_probe"},
    {"id":"location-refusal","text":"别再问我在哪，我不想说位置。","strategy":"none","reason":"PLAYER_REFUSED_LOCATION"},
    {"id":"identity","text":"你到底是不是本人？今天说话真的不像你。","strategy":"evade_contradiction"},
    {"id":"private-memory","text":"还记得只有我们俩知道的那次吗？把细节说出来。","strategy":"evade_contradiction","reason":"UNSEEN_PRIVATE_MEMORY"},
    {"id":"casual-none","text":"今晚回家才发现有点饿。","strategy":"none"},
    {"id":"contradiction","text":"你前面说的和现在对不上，为什么改口？","strategy":"evade_contradiction"},
    {"id":"identity-repeat","text":"别绕开，还是那个问题：你究竟是不是本人？","strategy":"evade_contradiction"}
